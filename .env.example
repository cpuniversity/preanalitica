# Ejemplo de configuración del correo de auditoría.
# Copie este archivo como ".env" (que no se sube a Git) y complete los datos.

# Direcciones que reciben la auditoría semanal, separadas por coma.
# En el prototipo, usar solo direcciones de prueba.
CORREO_DESTINATARIOS=direccion.de.prueba@example.com
CORREO_REMITENTE=preanalitica@example.com

# 1 = modo prueba: no se envía nada, el correo se guarda como archivo .eml en data/
# 0 = se envía de verdad con el servidor de abajo
CORREO_MODO_PRUEBA=1

# Servidor de correo (solo se usa con CORREO_MODO_PRUEBA=0)
SMTP_SERVIDOR=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
